{
  "name": "kafka-resiliency-consumer",
  "version": "1.0.0",
  "description": "A Kafka consumer that retries what might recover, parks what it can't process in a dead-letter topic, and stops when a bug hits every message",
  "type": "module",
  "license": "MIT",
  "author": "Ethan Nguyen",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "produce": "tsx scripts/produce.ts",
    "replay-dlq": "tsx scripts/replay-dlq.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
